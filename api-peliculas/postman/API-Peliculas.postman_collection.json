{
  "info": {
    "name": "API Películas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/peliculas"
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "1. Crear película",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.ok) pm.collectionVariables.set(\"id\", r.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Interstellar\",\n  \"genero\": \"Ciencia ficción\",\n  \"anio\": 2014,\n  \"director\": \"Christopher Nolan\",\n  \"calificacion\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "2. Listar películas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "3. Obtener por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "4. Actualizar calificación",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calificacion\": 9.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "5. Eliminar película",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "Campos obligatorios faltantes (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Sin datos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "Calificación fuera de rango (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Película X\",\n  \"genero\": \"Drama\",\n  \"anio\": 2020,\n  \"director\": \"Alguien\",\n  \"calificacion\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "Id inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "123"
              ]
            }
          }
        },
        {
          "name": "Película no encontrada (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "000000000000000000000000"
              ]
            }
          }
        }
      ]
    }
  ]
}